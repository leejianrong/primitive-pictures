# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore) and must never be committed.
# pipeline/orchestrate.py loads it automatically (via python-dotenv) on every
# run -- nothing else needs to source it by hand.

# Required for any real (non --dry-run) RunPod launch.
# Use a dedicated, limited-scope, revocable key -- not your main account key.
# Create one at https://www.runpod.io/console/user/settings -> API Keys.
RUNPOD_API_KEY=

# Required for any real (non --dry-run) RunPod launch. GPU type id(s) to
# request, comma-separated if you want to allow more than one as fallbacks.
# These are account/region-specific -- find valid ids with:
#   RUNPOD_API_KEY=... runpodctl gpu list
RP_GPU_TYPE=

# Not needed today -- pipeline/promptbank.py replaced the LLM prompt-gen step
# (see docs/adr/0006). Recorded here only so the slot exists if that ever
# changes: OpenRouter (OpenAI-compatible), a cheap model such as
# deepseek-chat, not Anthropic.
# OPENROUTER_API_KEY=

# --- Optional RunPod launch tuning ---
# These are read straight through to pipeline/runpod/launch.sh by whatever's
# in the environment when orchestrate.py runs. Unlike RP_POD_NAME/RP_POD_IMAGE
# /RP_MAX_HOURLY_USD/RP_MAX_LIFETIME_SECS/RP_CONTAINER_DISK_GB (all computed
# per-run by orchestrate.py from its own CLI flags/config.py -- setting those
# here would be silently overridden, so they're deliberately not listed),
# nothing in this pipeline sets these, so a value here actually takes effect.

# SECURE (reserved capacity) or COMMUNITY (cheaper, less consistent). Default: SECURE.
# RP_CLOUD_TYPE=SECURE

# Spot (interruptible, cheaper, ~5s reclaim warning -- fine since a batch job is
# re-runnable) vs on-demand. Default: true (spot).
# RP_INTERRUPTIBLE=true

# Dead-man's-switch idle watchdog: terminate if the job's log stops growing for
# this long. Defaults (900s / 60s poll) are generous for a batch job that prints
# progress per image, but raise RP_IDLE_TIMEOUT_SECS if a slow model download
# (no output during `pip install`) risks tripping it on a slow connection.
# RP_IDLE_TIMEOUT_SECS=900
# RP_IDLE_CHECK_SECS=60

# RunPod REST API base. This surface moves -- only override if testing a
# newer version.
# RP_API_BASE=https://rest.runpod.io/v1
