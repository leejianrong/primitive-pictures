# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore) and must never be committed.
# pipeline/orchestrate.py loads it automatically (via python-dotenv) on every
# run -- nothing else needs to source it by hand.

# Required for any real (non --dry-run) RunPod launch.
# Use a dedicated, limited-scope, revocable key -- not your main account key.
# Create one at https://www.runpod.io/console/user/settings -> API Keys.
RUNPOD_API_KEY=

# Required for any real (non --dry-run) RunPod launch. GPU type id(s) to
# request, comma-separated -- list several as fallbacks, since availability
# shifts hour to hour. RunPod tries them in order and stops at the first one
# it can rent, so list order is a priority, not just a wishlist: it does NOT
# pick the biggest one available, just the first-in-list one available.
# `runpodctl gpu list` is a starting point, but its gpuId values aren't all
# valid for pod creation (MIG variants 400 there even though gpu list shows
# them) -- the pod-create endpoint's actual enum comes back in a 400's error
# body if you send an invalid one.
#
# If any run includes flux-schnell (including --model compare), use 48GB+
# cards. Verified 2026-09-27: Flux OOM'd twice in a row, first on a 24GB
# card failing to even load the weights (~22GB used), then on a 32GB card
# failing mid-inference (~31.36 of 31.37GB used) -- 32GB is not safe headroom
# for this model, just a near miss. The obvious 48GB pick (A40) had zero
# stock everywhere on this date, so the working fallback list jumped to an
# 80GB tier (A100) instead -- raise RP_MAX_HOURLY_USD/config.py's
# DEFAULT_MAX_HOURLY_USD to clear that price if you hit the same gap.
RP_GPU_TYPE=

# Required only for --model flux-schnell / compare. Flux.1-schnell is a gated
# HuggingFace model: you must (1) accept its license at
# https://huggingface.co/black-forest-labs/FLUX.1-schnell and (2) create a
# read-scope token at https://huggingface.co/settings/tokens. Wired through
# to the pod's container env via RP_POD_ENV_JSON (see orchestrate.py's
# build_plan and docs/adr/0001's 2026-09-27 addendum); verified working
# end-to-end on a real pod.
# HF_TOKEN=

# Not needed today -- pipeline/promptbank.py replaced the LLM prompt-gen step
# (see docs/adr/0006). Recorded here only so the slot exists if that ever
# changes: OpenRouter (OpenAI-compatible), a cheap model such as
# deepseek-chat, not Anthropic.
# OPENROUTER_API_KEY=

# --- Optional RunPod launch tuning ---
# These are read straight through to pipeline/runpod/launch.sh by whatever's
# in the environment when orchestrate.py runs. Unlike RP_POD_NAME/RP_POD_IMAGE
# /RP_MAX_HOURLY_USD/RP_MAX_LIFETIME_SECS/RP_CONTAINER_DISK_GB (all computed
# per-run by orchestrate.py from its own CLI flags/config.py -- setting those
# here would be silently overridden, so they're deliberately not listed),
# nothing in this pipeline sets these, so a value here actually takes effect.

# SECURE (reserved capacity) or COMMUNITY (cheaper, less consistent). Default: SECURE.
# RP_CLOUD_TYPE=SECURE

# Spot vs on-demand. Default: false -- RunPod discontinued spot pods (verified
# 2026-09-27; interruptible=true now 500s with "Spot pods are no longer
# offered"). Left here in case that ever reverses.
# RP_INTERRUPTIBLE=false

# Dead-man's-switch idle watchdog: terminate if the job's log stops growing for
# this long. Defaults (900s / 60s poll) are generous for a batch job that prints
# progress per image, but raise RP_IDLE_TIMEOUT_SECS if a slow model download
# (no output during `pip install`) risks tripping it on a slow connection.
# RP_IDLE_TIMEOUT_SECS=900
# RP_IDLE_CHECK_SECS=60

# RunPod REST API base. This surface moves -- only override if testing a
# newer version.
# RP_API_BASE=https://rest.runpod.io/v1
