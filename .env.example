# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore) and must never be committed.
# pipeline/orchestrate.py loads it automatically (via python-dotenv) on every
# run -- nothing else needs to source it by hand.

# Required for any real (non --dry-run) RunPod launch.
# Use a dedicated, limited-scope, revocable key -- not your main account key.
# Create one at https://www.runpod.io/console/user/settings -> API Keys.
RUNPOD_API_KEY=

# Required for any real (non --dry-run) RunPod launch. GPU type id(s) to
# request, comma-separated if you want to allow more than one as fallbacks.
# These are account/region-specific -- find valid ids with:
#   RUNPOD_API_KEY=... runpodctl gpu list
RP_GPU_TYPE=

# Not needed today -- pipeline/promptbank.py replaced the LLM prompt-gen step
# (see docs/adr/0006). Recorded here only so the slot exists if that ever
# changes: OpenRouter (OpenAI-compatible), a cheap model such as
# deepseek-chat, not Anthropic.
# OPENROUTER_API_KEY=
